[Unit]
Description=Econ FX quote freshness check (숫자가 조용히 멈췄는지)
# 스크립트 자신이 깨졌을 때를 위한 안전망. '시세가 멈췄다' 알림은 스크립트가
# 직접 보낸다 — 상태가 바뀔 때만 보내야 해서 종료 코드로는 표현할 수 없다.
# (econ-sitecheck.service 와 같은 구조)
OnFailure=econ-alert@%n.service

[Service]
Type=oneshot
User=miniserver
WorkingDirectory=/home/miniserver/School-Project/backend
ExecStart=/home/miniserver/School-Project/backend/.venv/bin/python fx_freshness.py
