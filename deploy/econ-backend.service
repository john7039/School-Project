[Unit]
Description=Econ Backend (FastAPI)
After=network.target
# 실패하면 systemd 가 알림 유닛을 대신 실행한다.
# %n 은 이 유닛의 전체 이름 — 템플릿의 인스턴스(%i)로 넘어간다.
OnFailure=econ-alert@%n.service

[Service]
# uvicorn 은 nginx 뒤에만 있으면 된다. nginx 가 127.0.0.1:8000 으로
# 프록시하므로 바깥 인터페이스에 붙을 이유가 없다. 0.0.0.0 으로 두면
# 테일넷의 다른 기기가 nginx 를 건너뛰고 :8000 을 직접 칠 수 있다.
User=miniserver
WorkingDirectory=/home/miniserver/School-Project/backend
ExecStart=/home/miniserver/School-Project/backend/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000
Restart=always

[Install]
WantedBy=multi-user.target
