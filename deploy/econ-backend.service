[Unit]
Description=Econ Backend (FastAPI)
After=network.target

[Service]
User=miniserver
WorkingDirectory=/home/miniserver/School-Project/backend
ExecStart=/home/miniserver/School-Project/backend/.venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000
Restart=always

[Install]
WantedBy=multi-user.target
